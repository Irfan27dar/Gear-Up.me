# ─── Supabase ─────────────────────────────────────────────────────────────
# Create a project at https://supabase.com, then copy Project URL + anon key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — server only, used by the seed script. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Data source toggle ───────────────────────────────────────────────────
# "local"  → render from data/catalog.ts (works with zero backend; default)
# "supabase" → read catalog from Supabase (after you run migrations + seed)
NEXT_PUBLIC_DATA_SOURCE=local

# ─── Stripe (test mode) ───────────────────────────────────────────────────
# Leave blank to use the mock "Place order" flow (writes a pending order row).
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_ENABLE_STRIPE=false

# ─── Site ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3800
